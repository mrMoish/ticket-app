# Supabase Dashboard → Project Settings → API (или Connect)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Публичный ключ: anon (legacy) или publishable (sb_publishable_...). Service-role ключ сюда НЕ класть.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# true, когда приложение работает по HTTPS (в проде). Локально по http оставьте false.
COOKIE_SECURE=false
